repositories:
    # Autoware Dependencies
    src/external/autoware/universe/external/demos:
        type: git
        url: git@github.com:ros2/demos.git
        version: 0.27.1
    src/external/autoware/universe/external/filters:
        type: git
        url: git@github.com:ros/filters.git
        version: 2.1.0 
    src/external/autoware/universe/external/geographic_msgs:
        type: git
        url: git@github.com:ros-geographic-info/geographic_info.git 
        version: 1.0.5
    src/external/autoware/universe/external/grid_map:
        type: git
        url: git@github.com:ANYbotics/grid_map.git
        version: 2.1.0 
    src/external/autoware/universe/external/osqp_vendor:
        type: git
        url: git@github.com:raymondsong00/osqp_vendor.git 
        version: art-cmake
    src/external/autoware/universe/external/point_cloud_msg_wrapper:
        type: git
        url: git@gitlab.com:ApexAI/point_cloud_msg_wrapper.git 
        version: 1.0.7 
    src/external/autoware/universe/external/topic_tools:
        type: git
        url: git@github.com:ros-tooling/topic_tools.git
        version: 1.2.0
    # Lanelet2 Dependencies
    src/external/lanelet2/external/mrt_cmake_modules:
        type: git
        url: git@github.com:KIT-MRT/mrt_cmake_modules.git
        version: 1.0.9 
    src/external/lanelet2/external/lanelet2_core:
        type: git
        url: git@github.com:fzi-forschungszentrum-informatik/Lanelet2.git 
        version: 1.2.1 
    # PCL Dependencies
    src/external/pcl/external/pcl:
        type: git
        url: git@github.com:ros-perception/perception_pcl.git 
        version: 2.4.1 
    src/external/pcl/external/pcl_msgs:
        type: git
        url: git@github.com:ros-perception/pcl_msgs.git 
        version: 1.0.0 
    src/external/utils/misc/external/backward_ros:
        type: git
        url: git@github.com:pal-robotics/backward_ros.git
        version: 1.0.5
    src/external/utils/misc/external/diagnostics:
        type: git
        url: git@github.com:ros/diagnostics.git 
        version: 3.1.2
    src/external/utils/misc/external/foxglove_bridge:
        type: git
        url: git@github.com:foxglove/ros-foxglove-bridge.git 
        version: 0.8.2
    src/external/utils/misc/external/gps_msgs:
        type: git
        url: git@github.com:swri-robotics/gps_umd.git 
        version: 2.0.3
    src/external/utils/misc/external/nav2_msgs:
        type: git
        url: git@github.com:ros-planning/navigation2.git
        version: 1.2.6
    src/external/utils/misc/external/pluginlib:
        type: git
        url: git@github.com:ros/pluginlib.git
        version: 5.2.2 
    # Rviz Dependencies
    src/external/utils/rviz/external/ignition_math6_vendor:
        type: git
        url: git@github.com:gazebo-release/gz_math6_vendor.git
        version: 0.2.1
    src/external/utils/rviz/external/interactive_markers:
        type: git
        url: git@github.com:ros-visualization/interactive_markers.git
        version: 2.4.0
    src/external/utils/rviz/external/laser_geometry:
        type: git
        url: git@github.com:ros-perception/laser_geometry.git
        version: 2.5.0
    src/external/utils/rviz/external/map_msgs:
        type: git
        url: git@github.com:ros-planning/navigation_msgs.git
        version: 2.2.0
    src/external/utils/rviz/external/resource_retriever:
        type: git
        url: git@github.com:ros/resource_retriever.git 
        version: 3.2.2 
    src/external/utils/rviz/external/rviz:
        type: git
        url: git@github.com:ros2/rviz.git 
        version: 12.4.5 
    # RDE Dependencies
    src/external/behavior_planner/external/tcb_span:
        type: git
        url: git@github.com:PickNikRobotics/cpp_polyfills.git
        version: 1.0.2
    src/external/behavior_planner/external/rsl:
        type: git
        url: git@github.com:PickNikRobotics/rsl.git
        version: 1.1.0
    src/external/behavior_planner/external/generate_parameter_library:
        type: git
        url: git@github.com:PickNikRobotics/generate_parameter_library.git
        version: 0.3.7