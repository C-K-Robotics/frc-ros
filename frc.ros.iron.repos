repositories:
    # Utilities
    src/external/interfaces/image_pipeline:
        type: git
        url: git@github.com:ros-perception/image_pipeline.git
        version: iron
    src/external/utils/message_filters:
        type: git
        url: git@github.com:ros2/message_filters.git
        version: iron
    src/external/utils/vision_opencv:
        type: git
        url: git@github.com:ros-perception/vision_opencv.git
        version: iron
    # BehaviorTree
    src/external/behaviortree/behaviortree:
        type: git
        url: git@github.com:BehaviorTree/BehaviorTree.CPP.git
        version: master
    src/external/behaviortree/groot:
        type: git
        url: git@github.com:BehaviorTree/Groot.git
        version: master
    # NetworkTable Bridge
    src/external/interfaces/networktables_bridge:
        type: git
        url: git@github.com:C-K-Robotics/networktables_bridge.git
        version: main
    # pcl utils
    src/external/pcl/utils/pointcloud_to_laserscan:
        type: git
        url: https://github.com/ros-perception/pointcloud_to_laserscan.git
        version: 2.0.3